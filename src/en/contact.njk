---
layout: layouts/base.njk
permalink: /en/contact/
altUrl: /contact/
pageCrumb: "Contact"
pageTitle: "Contact · Aleksey Kornilov"
pageDescription: "Get in touch about app development or SEO: email, Telegram, VK, GitHub, or the form on this page. I reply within a day."
pageKeywords: "contact flutter developer, hire full-stack developer remote"
pageSchema: |
  {
    "@type": "ContactPage",
    "@id": "https://kor-nil.ru/en/contact/#contactpage",
    "url": "https://kor-nil.ru/en/contact/",
    "name": "Contact",
    "description": "Ways to reach Aleksey Kornilov"
  }
---

<section class="section container contact-hero">
  <p class="hero-eyebrow">Get in touch</p>
  <h1>Let's talk about your project</h1>
  <p class="section-lead">
    App development, SEO, a consultation, or a job opening: reach me any way you like.
    I reply within a day.
  </p>
</section>

<section class="section container">
  <h2 class="section-title">Email and social</h2>

  <div class="grid grid-3 contacts-grid">
    <a href="mailto:{{ site.contacts.email }}" class="card contact-card">
      <div class="card-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 5L2 7"></path>
        </svg>
      </div>
      <h3 class="card-title">Email</h3>
      <p class="card-description contact-value">{{ site.contacts.email }}</p>
    </a>

    <a href="https://t.me/{{ site.contacts.telegram }}" target="_blank" rel="noopener" class="card contact-card">
      <div class="card-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m22 2-11 11"></path>
          <path d="m22 2-6.5 20-4.5-9-9-4.5z"></path>
        </svg>
      </div>
      <h3 class="card-title">Telegram</h3>
      <p class="card-description contact-value">@{{ site.contacts.telegram }}</p>
    </a>

    <a href="{{ site.contacts.vk }}" target="_blank" rel="noopener" class="card contact-card">
      <div class="card-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 2H7a5 5 0 0 0-5 5v10a5 5 0 0 0 5 5h10a5 5 0 0 0 5-5V7a5 5 0 0 0-5-5z"></path>
          <path d="M8 12h8"></path>
          <path d="M12 8v8"></path>
        </svg>
      </div>
      <h3 class="card-title">VK</h3>
      <p class="card-description contact-value">vk.com/kornil88</p>
    </a>

    <a href="{{ site.contacts.github }}" target="_blank" rel="noopener" class="card contact-card">
      <div class="card-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
      </div>
      <h3 class="card-title">GitHub</h3>
      <p class="card-description contact-value">Aleksey-Kornilov</p>
    </a>
  </div>
</section>

<section class="section container">
  <div class="contact-form-wrap glass">
    <h2>Write to me now</h2>
    <p class="text-muted">Fill in the form and I will reply by email within a day.</p>

    <form class="contact-form" id="contact-form" data-telegram="{{ site.contacts.telegram }}" novalidate
          data-msg-fill="Please fill in all fields."
          data-msg-sending="Sending…"
          data-msg-ok="Thank you! Your message has been sent. I will reply by email within a day."
          data-msg-fail="Could not send. Please message me on Telegram: @"
          data-msg-send="Send">
      <div class="field">
        <label for="cf-name">Your name</label>
        <input type="text" id="cf-name" name="name" required autocomplete="name" placeholder="How should I address you">
      </div>
      <div class="field">
        <label for="cf-email">Email for the reply</label>
        <input type="email" id="cf-email" name="email" required autocomplete="email" placeholder="you@example.com">
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" required rows="5" placeholder="A few words about the project or the role"></textarea>
      </div>
      {#- Honeypot: hidden decoy field for spam bots; the server drops non-empty submissions. -#}
      <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;">
        <label for="cf-company">Leave this field empty</label>
        <input type="text" id="cf-company" name="company" tabindex="-1" autocomplete="off">
      </div>
      <div class="form-footer">
        <button type="submit" class="btn btn-primary btn-lg">Send</button>
        <p class="form-hint text-small text-muted">No spam. Your details are used only to reply to you.</p>
      </div>
      <div class="form-status" id="cf-status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<script src="/assets/js/contact-form.js" defer></script>
