    <thead><tr><th>Марка</th><th>Цемент, кг</th><th>Песок, кг</th><th>Щебень, кг</th><th>Вода, л</th><th>Где применяют</th></tr></thead>
    <tbody>
      <tr><td>М100</td><td>214</td><td>870</td><td>1080</td><td>210</td><td>подушка, подстилающий слой, бордюры</td></tr>
      <tr><td>М150</td><td>235</td><td>855</td><td>1080</td><td>210</td><td>стяжка, дорожки, отмостка, сарай</td></tr>
      <tr><td>М200</td><td>286</td><td>795</td><td>1080</td><td>210</td><td>фундамент лёгкого дома, баня, гараж</td></tr>
      <tr><td>М250</td><td>332</td><td>750</td><td>1080</td><td>215</td><td>дом из бруса или газоблока, плиты</td></tr>
