{#- Базовый layout — оборачивает контент страницы шапкой и футером.
   Переменные страницы (см. front matter каждой .njk):
     pageTitle, pageDescription, pageKeywords, pageImage, pageType, pageSchema, pageCrumb,
     altUrl (парная страница на другом языке — для hreflang и переключателя)
-#}
<!DOCTYPE html>
{%- set t = i18n[lang] %}
<html lang="{{ lang }}" dir="ltr">
<head>
{% include "components/head.njk" %}
</head>
<body>
{% include "components/header.njk" %}

<main id="main" class="main">
{%- if pageCrumb and not pageNoindex %}
<nav class="breadcrumbs container" aria-label="{{ t.crumbs }}">
  <ol>
    <li><a href="{{ t.home }}">{{ t.crumbHome }}</a></li>
    {%- if pageCrumbParent %}<li><a href="{{ pageCrumbParent.href }}">{{ pageCrumbParent.label }}</a></li>{% endif %}
    <li aria-current="page">{{ pageCrumb }}</li>
  </ol>
</nav>
{%- endif %}
{{ content | safe }}
{%- if '/tools/' in page.url and page.url != '/tools/' %}
<section class="section container tools-more">
  <h2 class="section-title">Другие калькуляторы</h2>
  <div class="tools-grid">
    {%- for cat in tools.categories %}{% for t in cat.items %}{% if t.href != page.url %}
    <a href="{{ t.href }}" class="card card-link tool-card tool-card--mini">
      <div class="card-icon tool-card-icon" aria-hidden="true">{{ t.icon }}</div>
      <h3 class="card-title">{{ t.title }}</h3>
      <p class="card-description">{{ t.text }}</p>
    </a>
    {%- endif %}{% endfor %}{% endfor %}
  </div>
</section>
{%- endif %}
</main>

{% include "components/footer.njk" %}

{#- JS — загружается в конце для скорости. Загрузка не блокирует рендер. -#}
<script src="/assets/js/theme-toggle.js"></script>
<script src="/assets/js/nav.js"></script>
</body>
</html>
