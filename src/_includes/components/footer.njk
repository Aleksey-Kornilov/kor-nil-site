{#- Нижний футер: контакты, соц-сети, копирайт. Тексты — из _data/i18n.json по lang. -#}
{%- set t = i18n[lang] %}
<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-name">{{ t.author.name }}</div>
      <div class="footer-role">{{ t.author.role }}</div>
      <div class="footer-city">{{ t.author.city }}, {{ t.author.country }}</div>
    </div>

    <nav class="footer-nav" aria-label="{{ t.footerNavLabel }}">
      <h3 class="footer-heading">{{ t.sections }}</h3>
      <ul>
        {%- for item in t.nav %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="footer-contacts">
      <h3 class="footer-heading">{{ t.contact }}</h3>
      <ul>
        <li><a href="mailto:{{ site.contacts.email }}" rel="me">{{ site.contacts.email }}</a></li>
        {%- if site.contacts.telegram %}<li><a href="https://t.me/{{ site.contacts.telegram }}" target="_blank" rel="me noopener">Telegram</a></li>{% endif %}
        {%- if site.contacts.vk %}<li><a href="{{ site.contacts.vk }}" target="_blank" rel="me noopener">{{ t.vk }}</a></li>{% endif %}
        {%- if site.contacts.github %}<li><a href="{{ site.contacts.github }}" target="_blank" rel="me noopener">GitHub</a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <small>© {{ '' | year }} {{ t.author.name }}. {{ t.rights }}</small>
      <small>{% if lang == "ru" %}<a href="/dom/k/">Вход для заказчиков</a> · <a href="/politika/">Политика обработки данных</a> · {% endif %}<a href="/sitemap.xml">{{ t.sitemap }}</a></small>
    </div>
  </div>
</footer>

{#- Плашка про cookie Метрики: один раз, «Понятно» запоминается в браузере. -#}
<div class="cookie-plashka" role="region" aria-label="{% if lang == "ru" %}Cookie{% else %}Cookies{% endif %}" hidden>
  <p>{% if lang == "ru" %}Сайт использует cookie Яндекс Метрики для статистики. <a href="/politika/">Подробнее</a>{% else %}This site uses Yandex Metrica cookies for visit statistics. <a href="/politika/">Details</a> (in Russian){% endif %}</p>
  <button type="button" class="btn btn-primary btn-sm">{% if lang == "ru" %}Понятно{% else %}OK{% endif %}</button>
</div>
<script src="/assets/js/cookie.js" defer></script>
