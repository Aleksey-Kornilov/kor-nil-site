{#- Нижний футер: контакты, соц-сети, копирайт. -#}
<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-name">{{ site.author.name }}</div>
      <div class="footer-role">{{ site.author.role }}</div>
      <div class="footer-city">{{ site.author.city }}, {{ site.author.country }}</div>
    </div>

    <nav class="footer-nav" aria-label="Разделы сайта">
      <h3 class="footer-heading">Разделы</h3>
      <ul>
        <li><a href="/">Главная</a></li>
        <li><a href="/projects/chatyadro/">ЧатЯдро</a></li>
        <li><a href="/seo/">SEO</a></li>
        <li><a href="/about/">Обо мне</a></li>
        <li><a href="/contact/">Контакты</a></li>
      </ul>
    </nav>

    <div class="footer-contacts">
      <h3 class="footer-heading">Связаться</h3>
      <ul>
        <li><a href="mailto:{{ site.contacts.email }}" rel="me">{{ site.contacts.email }}</a></li>
        {%- if site.contacts.telegram %}<li><a href="https://t.me/{{ site.contacts.telegram }}" target="_blank" rel="me noopener">Telegram</a></li>{% endif %}
        {%- if site.contacts.vk %}<li><a href="{{ site.contacts.vk }}" target="_blank" rel="me noopener">ВКонтакте</a></li>{% endif %}
        {%- if site.contacts.github %}<li><a href="{{ site.contacts.github }}" target="_blank" rel="me noopener">GitHub</a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <small>© {{ '' | year }} {{ site.author.name }}. Все права защищены.</small>
      <small><a href="/sitemap.xml">Карта сайта</a></small>
    </div>
  </div>
</footer>
