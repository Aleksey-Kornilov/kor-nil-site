{#-
  <head> — все meta-теги, OpenGraph, Twitter Card, JSON-LD.
  Переменные:
    pageTitle       — заголовок этой страницы
    pageDescription — краткое описание для поисковика (до 155 символов)
    pageKeywords    — доп. ключевые слова (опционально)
    pageImage       — путь к OG-картинке (опционально, дефолт /assets/images/og-default.png)
    pagePath        — путь текущей страницы для canonical
    pageType        — тип страницы для OG (website / article), по умолчанию website
    pageNoindex     — true для служебных страниц (404): noindex + без canonical
    pageCrumb       — короткое имя для хлебных крошек (видимых и BreadcrumbList); нет = крошек нет
  Стили страниц (pages/*.css) входят в общий бандл — pageStyles больше не нужен.
-#}
{% set _title = pageTitle or site.title %}
{% set _desc = pageDescription or site.description %}
{% set _image = pageImage or '/assets/images/og-default.png' %}
{% set _canonical = site.url + (pagePath or page.url) %}
{% set _ogType = pageType or 'website' %}

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

{#- SEO: title + description + канонический URL -#}
<title>{{ _title }}</title>
<meta name="description" content="{{ _desc }}">
{%- if pageKeywords %}<meta name="keywords" content="{{ pageKeywords }}">{% endif %}
{%- if not pageNoindex %}
<link rel="canonical" href="{{ _canonical }}">
{%- endif %}
<meta name="author" content="{{ site.author.name }}">
<meta name="robots" content="{% if pageNoindex %}noindex, follow{% else %}index, follow, max-image-preview:large{% endif %}">
<meta name="format-detection" content="telephone=no">

{#- Open Graph — красивое превью при шаринге в соцсети -#}
<meta property="og:type" content="{{ _ogType }}">
<meta property="og:title" content="{{ _title }}">
<meta property="og:description" content="{{ _desc }}">
<meta property="og:url" content="{{ _canonical }}">
<meta property="og:image" content="{{ site.url }}{{ _image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="{{ site.shortTitle }}">
<meta property="og:locale" content="{{ site.locale }}">

{#- Twitter Card -#}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ _title }}">
<meta name="twitter:description" content="{{ _desc }}">
<meta name="twitter:image" content="{{ site.url }}{{ _image }}">

{#- Тема (адаптивно к системе + под тумблер) -#}
<meta name="theme-color" content="{{ site.themeColorLight }}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{ site.themeColor }}" media="(prefers-color-scheme: dark)">

{#- Иконки -#}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">

{#- CSS: критичная часть инлайном (первая отрисовка без запроса в сеть),
    остальное — один минифицированный бандл с хешем. Сборка: lib/css-bundle.mjs -#}
<style>{{ criticalCss | safe }}</style>
<link rel="stylesheet" href="{{ cssBundleUrl }}">

{#- Инициализация темы ДО отрисовки (иначе флэш белого/чёрного) -#}
<script>
(function() {
  const saved = localStorage.getItem('theme');
  const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  document.documentElement.dataset.theme = saved || system;
})();
</script>

{#- Яндекс.Метрика (номер в site.json). Только на боевом домене — localhost и превью не считаем.
    Грузится отложенно: по первому действию посетителя (прокрутка, клик, касание) или через 4 с
    после полной загрузки. Иначе tag.js с Вебвизором даёт ~1,7 с блокировки на слабом телефоне
    и роняет первый экран — а сайт продаёт Core Web Vitals как услугу. -#}
{%- if site.metrika %}
<script>
(function () {
  if (!location.hostname.endsWith('kor-nil.ru')) return;
  var events = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];
  var started = false;
  function start() {
    if (started) return;
    started = true;
    events.forEach(function (e) { removeEventListener(e, start); });
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();
    for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id={{ site.metrika }}', 'ym');
    ym({{ site.metrika }}, 'init', {ssr:true, webvisor:true, clickmap:true, accurateTrackBounce:true, trackLinks:true});
  }
  events.forEach(function (e) { addEventListener(e, start, { passive: true }); });
  addEventListener('load', function () { setTimeout(start, 4000); });
})();
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ site.metrika }}" style="position:absolute; left:-9999px;" alt=""></div></noscript>
{%- endif %}

{#- Schema.org JSON-LD — структурированные данные для поисковиков -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "{{ site.url }}#person",
      "name": "{{ site.author.name }}",
      "alternateName": "{{ site.author.shortName }}",
      "jobTitle": "{{ site.author.role }}",
      "url": "{{ site.url }}",
      "email": "mailto:{{ site.contacts.email }}",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "{{ site.author.city }}",
        "addressCountry": "{{ site.author.country }}"
      },
      "sameAs": [
        {%- set sameAs = [] %}
        {%- if site.contacts.github %}{%- set sameAs = (sameAs.push(site.contacts.github), sameAs) %}{% endif %}
        {%- if site.contacts.telegram %}{%- set sameAs = (sameAs.push('https://t.me/' + site.contacts.telegram), sameAs) %}{% endif %}
        {%- if site.contacts.vk %}{%- set sameAs = (sameAs.push(site.contacts.vk), sameAs) %}{% endif %}
        {%- for link in sameAs %}"{{ link }}"{% if not loop.last %},{% endif %}{% endfor %}
      ],
      "knowsAbout": ["Flutter", "Dart", "Node.js", "PostgreSQL", "WebRTC", "PWA", "SEO"]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}#website",
      "url": "{{ site.url }}",
      "name": "{{ site.shortTitle }}",
      "description": "{{ site.description }}",
      "inLanguage": "{{ site.lang }}",
      "publisher": { "@id": "{{ site.url }}#person" }
    },
    {
      "@type": "WebPage",
      "@id": "{{ _canonical }}#webpage",
      "url": "{{ _canonical }}",
      "name": "{{ _title }}",
      "description": "{{ _desc }}",
      "isPartOf": { "@id": "{{ site.url }}#website" },
      "about": { "@id": "{{ site.url }}#person" },
      "inLanguage": "{{ site.lang }}"
    }
    {%- if pageCrumb and not pageNoindex %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ _canonical }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "{{ pageCrumb }}", "item": "{{ _canonical }}" }
      ]
    }
    {%- endif %}
    {%- if pageSchema %},{{ pageSchema | safe }}{% endif %}
  ]
}
</script>
